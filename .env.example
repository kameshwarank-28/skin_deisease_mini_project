# Application Configuration
APP_NAME=SkinDiseaseAI
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Dataset Paths
DATASET_ROOT=Z:/ALL/IMG_CLASSES
PROCESSED_DATA_DIR=./processed_dataset

# Model Configuration
MODEL_NAME=vit_base_patch16_224
MODEL_PATH=./models/best_vit_model.pth
IMAGE_SIZE=224
BATCH_SIZE=32
NUM_WORKERS=2
DEVICE=auto
CONFIDENCE_THRESHOLD=0.60

# Database
DATABASE_URL=sqlite:///./backend/app/skin_disease.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
